{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-apps",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "3fa5f734-0bcb-47a9-aad0-5a3ff5aa14a3","database_name": "web-apps" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "5d10d75879934763988ac0d6173f1198" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
